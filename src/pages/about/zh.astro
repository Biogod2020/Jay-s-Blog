---
import Layout from "../../layouts/Layout.astro";
import ProfileSidebarZh from "../../components/ProfileSidebarZh.astro";
import ProfileLanguageSwitch from "../../components/ProfileLanguageSwitch.astro";
import * as Narrative from "../../content/about/narrative.zh.md";
---

<Layout
  title="关于我 | 纪家灏"
  description="纪家灏，复旦大学上海医学院八年制临床医学博士阶段（神经病学），开发智能体把分散的生物医学数据整理为 AI 可用、可追溯核验的数据资源。"
  image="/social-image-zh.svg"
  maxWidth="max-w-6xl"
  lang="zh-CN"
>
  <div class="mt-4">
    <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow mb-3">Profile</p>
        <h1 class="font-display text-4xl font-medium text-ink dark:text-white md:text-5xl">关于我</h1>
      </div>
      <ProfileLanguageSwitch current="zh" />
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4 lg:col-span-3">
        <ProfileSidebarZh />
      </div>

      <div class="md:col-span-8 md:pl-6 lg:col-span-9 lg:pl-10">
        <article class="profile-prose prose prose-lg prose-indigo max-w-3xl dark:prose-invert prose-headings:font-medium prose-a:decoration-accent-300 prose-a:underline-offset-4">
          <Narrative.Content />
        </article>
      </div>
    </div>
  </div>
</Layout>
