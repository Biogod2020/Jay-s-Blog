---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { publicPosts, languageOf, postPath } from "../lib/site.mjs";

// English homepage: show the English version of a post when one exists.
const allPosts = publicPosts(await getCollection("blog"));
const slugs = new Set(allPosts.map((p) => p.slug));
const posts = allPosts
  .filter((p) => (p.slug.endsWith("-en") ? true : !slugs.has(`${p.slug}-en`)))
  .slice(0, 6);

// Facts below follow the November 2026 application CV and research statement.
// SpatialDataAgent and CaseReportAgent are the two featured projects.
const stats = [
  { value: "12,163", label: "public spatial-omics samples rebuilt into one AI-ready format (SpatialDataAgent)" },
  { value: "635 M", label: "spatial observations in that atlas, across 12 platforms and 42 species" },
  { value: "152,258", label: "published case reports rebuilt as replayable clinical decisions (CaseReportAgent)" },
  { value: "27.9→12.0%", label: "how often a fine-tuned 4B model repeats an error the case report documented" },
];

const sdaSteps = [
  ["Find", "A fast decision model reads every GEO record and picks out the studies that really are spatial transcriptomics."],
  ["Convert", "An agent writes conversion code for each sample, whatever format the lab used, into one standard layout."],
  ["Check", "A fixed scorer compares the result with the original files. Failures go back for repair; anything that still fails is not released."],
  ["Review", "Every released sample is checked by eye for image–expression alignment, and each file keeps a record of where it came from."],
];

// Schematic only: shows the structure of a replayable case, not a real patient.
const caseEvents = [
  { t: "Admission", kind: "Finding", text: "Presenting symptoms and examination", src: "¶2" },
  { t: "Day 1", kind: "Order", text: "Imaging and laboratory tests requested", src: "¶3" },
  { t: "Day 1", kind: "Result", text: "Test results returned", src: "Fig. 1" },
  { t: "Day 2", kind: "Decision point", text: "What should the team do next?", src: "", hidden: true },
];

const otherWork = [
  {
    title: "Choosing answers in multi-agent systems",
    status: "Co-first author · arXiv preprint",
    href: "https://arxiv.org/abs/2608.25937",
    text: "When several agents answer one question, majority voting can discard a correct minority answer. A selection rule combining answer frequency with an LLM judge's score raised accuracy from 63.82% to 70.82–70.95% across 5 benchmarks and 16,278 questions, with the candidate answers held fixed.",
  },
  {
    title: "Spatial organisation of Alzheimer's disease",
    status: "Co-first author · under review at Science",
    text: "Links reactive microglia in subpallial regions to cholinergic vulnerability. I registered the spatial transcriptomics sections and ran most of the quantitative spatial analysis, including the GOLD index, which tests whether microglial states change with distance from plaques.",
  },
  {
    title: "BioMed-Banana: cell segmentation with an image-editing model",
    status: "Study design and main implementation · in preparation",
    text: "With 128 training images, an adapted Qwen-Image-Edit reached panoptic quality 0.625 on PanNuke, above Cellpose-SAM (0.602), which was trained on 22,826 images.",
  },
];

const publications = [
  {
    authors: "<b>Ji J-H</b>, Zou Q, Cheng J, et al., Yu J-T, Yuan Z.",
    title: "An agent-built, verified atlas of public spatial transcriptomics shows that breadth across studies drives transfer and reproducibility.",
    venue: "bioRxiv, 2026.",
    href: "https://www.biorxiv.org/content/10.64898/2026.05.27.727615v2",
  },
  {
    authors: "<b>Ji J-H</b>, Zou Q, Cheng J, et al., Yu J-T, Yuan Z.",
    title: "SpatialDataAgent: Autonomous curation of a decade of public spatial omics at scale.",
    venue: "Submitted to ICLR 2027.",
    href: "https://openreview.net/forum?id=iB4on39JQE",
  },
  {
    authors: "Hao Y-N, <b>Ji J-H</b> (co-first), et al.",
    title: "Spatiotemporally resolved transcriptome links reactive subpallial microglia to cholinergic vulnerability in Alzheimer's disease.",
    venue: "Under review at Science, 2026.",
  },
  {
    authors: "<b>Ji J-H</b> (co-first), Li S, Cheng J, She Z, Yu J-T, Yuan Z.",
    title: "Candidate supply and answer selection shape the value of LLM judging in multi-agent systems.",
    venue: "arXiv:2608.25937, 2026.",
    href: "https://arxiv.org/abs/2608.25937",
  },
];
---

<Layout
  title="Jia-Hao Ji | AI-ready biomedical data, built and checked by agents"
  description="Jia-Hao (Jay) Ji is a Fudan University physician-scientist in training (neurology) who builds agents that turn scattered biomedical evidence into data that AI can use and people can check."
  maxWidth="max-w-6xl"
>
  <!-- Hero -->
  <section class="grid grid-cols-1 items-center gap-10 pb-14 pt-6 md:grid-cols-12 md:gap-14 md:pb-20 md:pt-12">
    <div class="md:col-span-8">
      <p class="eyebrow mb-6">Physician-scientist in training · Fudan University</p>
      <h1 class="font-display text-[2.35rem] font-medium leading-[1.12] text-ink dark:text-white md:text-[3.4rem]">
        I build agents that turn scattered public biomedical data into AI&#8209;ready resources that people can verify.
      </h1>
      <p class="mt-7 max-w-2xl text-lg leading-relaxed text-ink-soft dark:text-gray-300">
        I am Jia-Hao (Jay) Ji, a doctoral-stage student in Fudan's eight-year clinical medicine program, trained in neurology.
        Most public biomedical data is stored in formats that AI cannot use without weeks of manual cleanup.
        My work hands that cleanup to agents, with checks that tie every output back to its source.
        Two systems show the approach: <a class="link-u text-ink dark:text-white" href="#research">SpatialDataAgent</a> for spatial-omics data and <a class="link-u text-ink dark:text-white" href="#research">CaseReportAgent</a> for clinical case reports.
      </p>
      <p class="mt-5 text-sm text-ink-mute dark:text-gray-400">
        Advised by <a class="link-u" href="https://imgg.fudan.edu.cn/kydw/jpzj/yjt.htm">Jin-Tai Yu</a> and
        <a class="link-u" href="https://ystlab.github.io/YuanSTLab/">Zhiyuan Yuan</a> · Graduating June 2027 · Open to postdoctoral positions and collaborations
      </p>
      <div class="mt-8 flex flex-wrap items-center gap-3 text-sm font-medium">
        <a href="/Jia-Hao_Ji_Academic_CV.pdf" class="rounded-full bg-ink px-5 py-2.5 text-white transition hover:bg-accent-800 dark:bg-white dark:text-ink dark:hover:bg-accent-100">Download CV</a>
        <a href="mailto:jhji19@fudan.edu.cn" class="rounded-full border border-black/15 px-5 py-2.5 text-ink transition hover:border-ink dark:border-white/20 dark:text-white dark:hover:border-white">Email</a>
        <a href="https://github.com/Biogod2020" class="rounded-full border border-black/15 px-5 py-2.5 text-ink transition hover:border-ink dark:border-white/20 dark:text-white dark:hover:border-white" rel="me">GitHub</a>
        <a href="/about/" class="px-2 py-2.5 text-ink-soft transition hover:text-ink dark:text-gray-300 dark:hover:text-white">About me →</a>
        <a href="/about/zh/" lang="zh-CN" class="px-2 py-2.5 text-ink-soft transition hover:text-ink dark:text-gray-300 dark:hover:text-white">中文</a>
      </div>
    </div>
    <figure class="mx-auto w-56 sm:w-64 md:col-span-4 md:w-full md:max-w-[300px]">
      <img
        src="/images/profile/portrait-720.webp"
        srcset="/images/profile/portrait-420.webp 420w, /images/profile/portrait-720.webp 720w"
        sizes="(min-width: 768px) 300px, 256px"
        width="720" height="960"
        alt="Portrait of Jia-Hao Ji"
        class="aspect-[3/4] w-full rounded-2xl object-cover shadow-[0_20px_50px_-25px_rgba(10,34,36,.45)]"
      />
    </figure>
  </section>

  <!-- At a glance -->
  <section aria-label="Work at a glance" class="grid grid-cols-2 border-y rule md:grid-cols-4">
    {stats.map((s, i) => (
      <div class:list={["px-1 py-7 md:px-6", i > 0 && "md:border-l rule", i % 2 === 1 && "border-l rule md:border-l", i >= 2 && "border-t rule md:border-t-0"]}>
        <p class="font-display tnum text-3xl font-medium text-ink dark:text-white md:text-4xl">{s.value}</p>
        <p class="mt-2 pr-2 text-[13px] leading-snug text-ink-soft dark:text-gray-400">{s.label}</p>
      </div>
    ))}
  </section>

  <!-- Featured projects -->
  <section id="research" class="scroll-mt-24 pt-20">
    <p class="eyebrow mb-3">Featured work</p>
    <h2 class="font-display max-w-3xl text-3xl font-medium leading-snug text-ink dark:text-white md:text-4xl">Two systems that turn public records into data a model can learn from</h2>

    <!-- SpatialDataAgent -->
    <article class="mt-10 overflow-hidden rounded-3xl border border-black/10 bg-white dark:border-white/10 dark:bg-white/[.03]">
      <div class="border-b border-black/10 dark:border-white/10">
        <video class="block aspect-video w-full bg-white" controls preload="none" playsinline poster="/media/spatialdataagent-poster.webp" aria-label="SpatialDataAgent explainer film, 4 minutes 53 seconds, narrated">
          <source src="/media/spatialdataagent-film.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="grid grid-cols-1 gap-10 p-7 md:grid-cols-12 md:p-10">
        <div class="md:col-span-5">
          <p class="tnum font-display text-sm text-accent-600 dark:text-accent-300">01 · Spatial omics data</p>
          <h3 class="font-display mt-2 text-3xl font-medium text-ink dark:text-white">SpatialDataAgent</h3>
          <p class="mt-2 text-[13px] text-ink-mute dark:text-gray-400">First author · bioRxiv preprint · ICLR 2027 submission</p>
          <p class="mt-5 text-[15px] leading-relaxed text-ink-soft dark:text-gray-300">
            Spatial transcriptomics measures gene activity at known positions in a tissue section. Ten years of these datasets sit in public archives, but every lab packaged them differently, so almost none can be used together. I proposed and led the agent system that gathers them into one checked atlas.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-4 border-t rule pt-5">
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">12,163</p><p class="text-xs text-ink-mute dark:text-gray-400">samples, 12 platforms, 42 species</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">8,211</p><p class="text-xs text-ink-mute dark:text-gray-400">with paired tissue images</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">635 M</p><p class="text-xs text-ink-mute dark:text-gray-400">spatial observations</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">2,411</p><p class="text-xs text-ink-mute dark:text-gray-400">spatial studies found among 298,179 GEO records</p></div>
          </div>
          <p class="mt-6 flex flex-wrap gap-4 text-sm">
            <a class="link-u text-accent-700 dark:text-accent-300" href="https://www.biorxiv.org/content/10.64898/2026.05.27.727615v2">bioRxiv ↗</a>
            <a class="link-u text-accent-700 dark:text-accent-300" href="https://openreview.net/forum?id=iB4on39JQE">OpenReview ↗</a>
          </p>
        </div>
        <div class="md:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-mute dark:text-gray-500">How it works</p>
          <ol class="mt-3 divide-y rule border-y rule">
            {sdaSteps.map(([k, v], i) => (
              <li class="grid grid-cols-[1.5rem_1fr] gap-x-3 gap-y-1 py-4 text-[15px] leading-relaxed sm:grid-cols-[2rem_5rem_1fr]">
                <span class="tnum font-display text-accent-600 dark:text-accent-300">{i + 1}</span>
                <span class="font-medium text-ink dark:text-white">{k}</span>
                <span class="col-start-2 text-ink-soft dark:text-gray-300 sm:col-start-auto">{v}</span>
              </li>
            ))}
          </ol>
          <p class="mt-5 rounded-xl bg-accent-50 px-5 py-4 text-[15px] leading-relaxed text-ink dark:bg-accent-950/60 dark:text-gray-100">
            <span class="font-semibold">What the atlas showed.</span> With the number of training patches held fixed, models that predict gene expression from tissue images transferred better to new studies when the patches came from more studies. Breadth across studies mattered, not just volume.
          </p>
        </div>
      </div>
    </article>

    <!-- CaseReportAgent -->
    <article class="mt-8 overflow-hidden rounded-3xl border border-black/10 bg-white dark:border-white/10 dark:bg-white/[.03]">
      <div class="grid grid-cols-1 gap-10 p-7 md:grid-cols-12 md:p-10">
        <div class="md:col-span-5">
          <p class="tnum font-display text-sm text-accent-600 dark:text-accent-300">02 · Clinical decision data</p>
          <h3 class="font-display mt-2 text-3xl font-medium text-ink dark:text-white">CaseReportAgent</h3>
          <p class="mt-2 text-[13px] text-ink-mute dark:text-gray-400">Research lead · manuscript in preparation</p>
          <p class="mt-5 text-[15px] leading-relaxed text-ink-soft dark:text-gray-300">
            Case reports are written after the outcome is known, so early details often give the diagnosis away. CaseReportAgent rewrites each published report as a time-ordered clinical log. Every event cites the sentence or image it came from and may refer only to earlier events, so a case can be replayed and a model asked to decide at any point without seeing the future.
          </p>
          <div class="mt-6 grid grid-cols-2 gap-4 border-t rule pt-5">
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">152,258</p><p class="text-xs text-ink-mute dark:text-gray-400">case reports rebuilt from PubMed Central</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">80,000</p><p class="text-xs text-ink-mute dark:text-gray-400">decision points (up to) used to fine-tune Qwen3</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">27.9→12.0%</p><p class="text-xs text-ink-mute dark:text-gray-400">4B model repeating an error the report documented</p></div>
            <div><p class="font-display tnum text-2xl text-ink dark:text-white">1–75%</p><p class="text-xs text-ink-mute dark:text-gray-400">questions leaking the answer in 8 external benchmarks</p></div>
          </div>
        </div>
        <div class="md:col-span-7">
          <p class="text-xs font-semibold uppercase tracking-wider text-ink-mute dark:text-gray-500">A replayable case (schematic)</p>
          <ol class="relative mt-4 space-y-3 border-l-2 border-accent-200 pl-6 dark:border-accent-800" aria-label="Schematic of a replayable clinical log">
            {caseEvents.map((e) => (
              <li class:list={["relative rounded-xl border px-4 py-3", e.hidden ? "border-dashed border-accent-400 bg-accent-50 dark:border-accent-500 dark:bg-accent-950/60" : "border-black/10 bg-paper dark:border-white/10 dark:bg-white/[.02]"]}>
                <span class:list={["absolute -left-[33px] top-4 h-3 w-3 rounded-full ring-4 ring-white dark:ring-paper-dark", e.hidden ? "bg-accent-500" : "bg-accent-200 dark:bg-accent-700"]}></span>
                <p class="flex flex-wrap items-baseline justify-between gap-2 text-xs">
                  <span class="tnum text-ink-mute dark:text-gray-400">{e.t} · <span class="font-semibold uppercase tracking-wider text-accent-700 dark:text-accent-300">{e.kind}</span></span>
                  {e.src && <span class="rounded bg-black/5 px-1.5 py-0.5 font-mono text-[11px] text-ink-soft dark:bg-white/10 dark:text-gray-300">source: {e.src}</span>}
                </p>
                <p class:list={["mt-1 text-[15px]", e.hidden ? "font-medium text-ink dark:text-white" : "text-ink-soft dark:text-gray-300"]}>{e.text}</p>
              </li>
            ))}
          </ol>
          <p class="mt-4 text-sm leading-relaxed text-ink-soft dark:text-gray-400">
            At the decision point the model sees only the events above it. It learns from the decisions the team actually made, and is tested on whether it repeats errors the report itself records. The same replay exposed answer leakage in existing medical AI benchmarks.
          </p>
        </div>
      </div>
    </article>

    <!-- Other work -->
    <div class="mt-16">
      <p class="eyebrow mb-5">Other work</p>
      <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
        {otherWork.map((w) => (
          <article class="border-t rule pt-5">
            <h3 class="font-display text-xl font-medium leading-snug text-ink dark:text-white">{w.href ? <a class="link-u" href={w.href}>{w.title}</a> : w.title}</h3>
            <p class="mt-1 text-[13px] text-ink-mute dark:text-gray-400">{w.status}</p>
            <p class="mt-3 text-sm leading-relaxed text-ink-soft dark:text-gray-300">{w.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Next -->
  <section class="mt-20 rounded-2xl bg-accent-50 px-6 py-10 dark:bg-accent-950/60 md:px-12 md:py-12">
    <p class="eyebrow mb-3">Next</p>
    <h2 class="font-display max-w-3xl text-2xl font-medium leading-snug text-ink dark:text-white md:text-3xl">
      From one data type to many: an AI-ready brain MRI resource, and the rules for scaling agents that build data.
    </h2>
    <div class="mt-6 grid grid-cols-1 gap-6 text-[15px] leading-relaxed text-ink-soft dark:text-gray-300 md:grid-cols-2">
      <p>The next step applies the SpatialDataAgent approach to brain MRI: multi-source, multi-sequence scans with consistent metadata, quality records and a link back to every original file.</p>
      <p>Underneath it is a research question: how the yield of reliable data changes as agents are given more compute and more varied sources, and at which points a short human check is worth more than another round of automatic repair.</p>
    </div>
  </section>

  <!-- Publications -->
  <section class="pt-20">
    <p class="eyebrow mb-3">Papers</p>
    <h2 class="font-display mb-8 text-3xl font-medium text-ink dark:text-white md:text-4xl">Preprints and submissions</h2>
    <ol class="divide-y rule border-y rule">
      {publications.map((pub) => (
        <li class="py-5 text-[15px] leading-relaxed">
          <p class="text-ink dark:text-gray-100">{pub.href ? <a class="link-u" href={pub.href}>{pub.title}</a> : pub.title}</p>
          <p class="mt-1 text-sm text-ink-soft dark:text-gray-400"><Fragment set:html={pub.authors} /> <i>{pub.venue}</i></p>
        </li>
      ))}
    </ol>
  </section>

  <!-- Writing + elsewhere -->
  <div class="grid grid-cols-1 gap-14 pt-20 lg:grid-cols-12">
    <section class="lg:col-span-8">
      <div class="mb-6 flex items-end justify-between">
        <div>
          <p class="eyebrow mb-3">Writing</p>
          <h2 class="font-display text-3xl font-medium text-ink dark:text-white md:text-4xl">Notes and essays</h2>
        </div>
        <a href="/blog/" class="text-sm text-ink-soft hover:text-ink dark:text-gray-400 dark:hover:text-white">All articles →</a>
      </div>
      <ul class="divide-y rule border-y rule">
        {posts.map((post) => (
          <li>
            <a href={postPath(post)} class="group grid grid-cols-[5.5rem_1fr] gap-4 py-5">
              <time class="tnum pt-0.5 text-sm text-ink-mute dark:text-gray-500" datetime={post.data.pubDate.toISOString()}>{post.data.pubDate.toISOString().slice(0, 7)}</time>
              <span>
                <span class="block font-medium text-ink transition group-hover:text-accent-700 dark:text-gray-100 dark:group-hover:text-accent-300" lang={languageOf(post)}>{post.data.title}</span>
                <span class="mt-1 line-clamp-2 block text-sm text-ink-soft dark:text-gray-400" lang={languageOf(post)}>{post.data.description}</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <aside class="space-y-10 lg:col-span-4">
      <section>
        <p class="eyebrow mb-4">Teaching</p>
        <ul class="space-y-3 text-sm leading-relaxed text-ink-soft dark:text-gray-300">
          <li>Medical education videos in Chinese and English on <a class="link-u" href="https://space.bilibili.com/645730045/">Bilibili</a> and <a class="link-u" href="https://www.youtube.com/@JayJi-wm7yp/playlists">YouTube</a>.</li>
          <li>Volunteer teaching in rural Guizhou and Guangdong: probability and statistics for everyday decisions.</li>
        </ul>
      </section>
      <section>
        <p class="eyebrow mb-4">Open source</p>
        <ul class="space-y-3 text-sm leading-relaxed text-ink-soft dark:text-gray-300">
          <li><a class="link-u text-ink dark:text-white" href="https://github.com/Biogod2020/dsh-article-review">dsh-article-review</a> — AI manuscript edits shown as word-level changes the author accepts or rejects.</li>
          <li><a class="link-u text-ink dark:text-white" href="https://github.com/Biogod2020/simple-fig-skill">simple-fig-skill</a> — agent skill for editable scientific figures checked at print size.</li>
          <li><a class="link-u text-ink dark:text-white" href="https://github.com/Biogod2020/sci-video-skill">sci-video-skill</a> — narrated research explainer films rendered from code.</li>
        </ul>
      </section>
      <section class="site-subscribe !my-0">
        <h3 class="text-base font-semibold">Follow the writing</h3>
        <p class="mt-2 text-sm leading-relaxed text-ink-soft dark:text-gray-300">New articles in your RSS reader. No account needed.</p>
        <a href="/rss/zh.xml">中文 RSS</a><a href="/rss/en.xml">English RSS</a>
      </section>
    </aside>
  </div>
</Layout>
