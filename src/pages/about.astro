---
import Layout from "../layouts/Layout.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import * as Narrative from "../content/about/narrative.md";
---

<Layout
  title="About | Jia-Hao Ji"
  description="Research profile of Jia-Hao Ji, an M.D. candidate and AI researcher working on agentic AI, multimodal biomedical learning, spatial omics, and multi-agent reasoning."
  maxWidth="max-w-6xl"
>
  <div class="mt-4 grid grid-cols-1 gap-8 md:grid-cols-12">
    <div class="md:col-span-4 lg:col-span-3">
      <ProfileSidebar />
    </div>

    <div
      class="rounded-2xl border border-gray-100 bg-white p-7 shadow-sm dark:border-gray-700 dark:bg-gray-800 md:col-span-8 md:p-10 lg:col-span-9"
    >
      <h1
        class="mb-8 border-b border-gray-200 pb-4 text-4xl font-bold text-gray-900 dark:border-gray-700 dark:text-white"
      >
        About
      </h1>
      <article class="prose prose-indigo max-w-none dark:prose-invert">
        <Narrative.Content />
      </article>
    </div>
  </div>
</Layout>
