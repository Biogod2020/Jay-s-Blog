---
import Layout from "../layouts/Layout.astro";
import ProfileSidebar from "../components/ProfileSidebar.astro";
import ProfileLanguageSwitch from "../components/ProfileLanguageSwitch.astro";
import * as Narrative from "../content/about/narrative.md";
---

<Layout
  title="About | Jia-Hao Ji"
  description="Research profile of Jia-Hao (Jay) Ji, a Fudan neurology MD student who builds agents that turn scattered biomedical evidence into verifiable, AI-ready data."
  maxWidth="max-w-6xl"
>
  <div class="mt-4">
    <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="eyebrow mb-3">Profile</p>
        <h1 class="font-display text-4xl font-medium text-ink dark:text-white md:text-5xl">About</h1>
      </div>
      <ProfileLanguageSwitch current="en" />
    </div>

    <div class="grid grid-cols-1 gap-10 md:grid-cols-12">
      <div class="md:col-span-4 lg:col-span-3">
        <ProfileSidebar />
      </div>

      <div class="md:col-span-8 md:pl-6 lg:col-span-9 lg:pl-10">
        <article class="profile-prose prose prose-lg prose-indigo max-w-3xl dark:prose-invert prose-headings:font-medium prose-a:decoration-accent-300 prose-a:underline-offset-4">
          <Narrative.Content />
        </article>
      </div>
    </div>
  </div>
</Layout>
