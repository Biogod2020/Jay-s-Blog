---
import Layout from "../../layouts/Layout.astro";

const researchAreas = [
  {
    title: "科学智能体",
    description: "面向科研数据与复杂工作流的证据驱动自主系统。",
  },
  {
    title: "多模态生物医学 AI",
    description: "连接空间组学、数字病理、临床知识与神经系统疾病。",
  },
  {
    title: "可靠多智能体推理",
    description: "研究候选生成、评审可靠性、通信与最终答案选择。",
  },
];
---

<Layout
  title="纪家灏 | 医学博士候选人及人工智能研究者"
  description="纪家灏，复旦大学上海医学院八年制医学博士候选人，研究方向包括科学智能体、多模态生物医学人工智能、空间组学与可靠多智能体推理。"
  image="/social-image-zh.svg"
  maxWidth="max-w-7xl"
  locale="zh"
  lang="zh-CN"
>
  <section class="relative overflow-hidden py-14 md:py-24">
    <div class="absolute inset-0 -z-10 bg-gradient-to-br from-indigo-50/80 via-white/50 to-cyan-50/70 dark:from-gray-900/60 dark:via-gray-900/30 dark:to-indigo-950/40"></div>
    <div class="absolute left-1/2 top-0 -z-10 aspect-square w-full max-w-[900px] -translate-x-1/2 rounded-full bg-indigo-500/10 blur-3xl"></div>

    <div class="mx-auto max-w-5xl px-4 text-center">
      <div class="mb-7 inline-flex rounded-full border border-indigo-200 bg-white/75 px-4 py-2 text-xs font-semibold tracking-wide text-indigo-700 shadow-sm backdrop-blur dark:border-indigo-800 dark:bg-gray-900/60 dark:text-indigo-300 md:text-sm">
        复旦大学八年制医学博士候选人 · 人工智能研究者
      </div>
      <h1 class="mb-7 text-4xl font-extrabold leading-tight tracking-tight text-gray-950 dark:text-white md:text-6xl lg:text-7xl">
        构建面向生物医学发现的
        <span class="block bg-gradient-to-r from-indigo-600 to-cyan-600 bg-clip-text text-transparent dark:from-indigo-400 dark:to-cyan-400">可靠智能系统</span>
      </h1>
      <p class="mx-auto max-w-3xl text-lg leading-relaxed text-gray-600 dark:text-gray-300 md:text-xl">
        我是纪家灏，目前就读于复旦大学上海医学院八年制临床医学专业。我的研究连接临床医学、计算生物学与人工智能，重点探索空间组学、神经科学、科学智能体和多智能体推理。
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href="#research" class="rounded-lg bg-indigo-600 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-700">查看代表性研究</a>
        <a href="/Jia-Hao_Ji_CV_zh.pdf" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-indigo-200 bg-white/85 px-5 py-3 text-sm font-semibold text-indigo-700 transition hover:border-indigo-400 hover:bg-indigo-50 dark:border-indigo-800 dark:bg-gray-900/70 dark:text-indigo-300">中文一页简历 ↗</a>
        <a href="/" class="rounded-lg border border-gray-300 bg-white/80 px-5 py-3 text-sm font-semibold text-gray-800 transition hover:border-indigo-400 hover:text-indigo-600 dark:border-gray-700 dark:bg-gray-900/70 dark:text-gray-100">English Profile</a>
      </div>
      <div class="mx-auto mt-10 grid max-w-5xl grid-cols-1 gap-3 md:grid-cols-3">
        {
          researchAreas.map((area) => (
            <div class="rounded-xl border border-gray-200 bg-white/65 px-5 py-4 text-left backdrop-blur dark:border-gray-700 dark:bg-gray-800/50">
              <h2 class="text-base font-bold text-gray-900 dark:text-white">{area.title}</h2>
              <p class="mt-1 text-sm leading-relaxed text-gray-600 dark:text-gray-300">{area.description}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <section id="research" class="scroll-mt-24">
      <div class="mb-7 flex flex-col gap-3 border-b border-gray-200 pb-4 dark:border-gray-700 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">Selected Research</p>
          <h2 class="text-3xl font-bold text-gray-950 dark:text-white">代表性研究</h2>
        </div>
        <a href="https://arxiv.org/abs/2608.25937" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-indigo-600 hover:text-indigo-800 dark:text-indigo-400">查看最新预印本 ↗</a>
      </div>

      <article class="overflow-hidden rounded-2xl border border-indigo-200 bg-gradient-to-br from-indigo-50 via-white to-cyan-50 p-7 shadow-sm dark:border-indigo-800 dark:from-indigo-950/40 dark:via-gray-900 dark:to-cyan-950/30 md:p-10">
        <div class="mb-5 inline-flex rounded-full bg-indigo-600 px-3 py-1 text-xs font-bold tracking-wider text-white">第一作者 · arXiv 2026</div>
        <h3 class="max-w-4xl text-2xl font-bold leading-snug text-gray-950 dark:text-white md:text-4xl">
          <a href="https://arxiv.org/abs/2608.25937" target="_blank" rel="noopener noreferrer" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">
            候选答案供给与最终选择共同决定大模型评审在多智能体系统中的价值
          </a>
        </h3>
        <p class="mt-3 text-sm leading-relaxed text-gray-500 dark:text-gray-400">
          Candidate supply and answer selection shape the value of LLM judging in multi-agent systems
        </p>
        <p class="mt-5 max-w-4xl text-base leading-relaxed text-gray-700 dark:text-gray-300 md:text-lg">
          我们将多智能体推理解耦为候选生成、答案识别与终端选择。实验表明，正确答案往往已经出现在候选池中，却会在共识过程中被多数错误答案淹没；基于大模型评审的终端选择可以在不改变候选池的前提下挽救正确少数答案。
        </p>
        <div class="mt-7 grid grid-cols-1 gap-4 sm:grid-cols-3">
          <div class="rounded-xl border border-white/70 bg-white/75 p-4 dark:border-gray-700 dark:bg-gray-900/60"><p class="text-2xl font-bold text-gray-950 dark:text-white">15,336</p><p class="mt-1 text-xs text-gray-600 dark:text-gray-400">用于刻画评审可靠性的问题数</p></div>
          <div class="rounded-xl border border-white/70 bg-white/75 p-4 dark:border-gray-700 dark:bg-gray-900/60"><p class="text-2xl font-bold text-gray-950 dark:text-white">81,390</p><p class="mt-1 text-xs text-gray-600 dark:text-gray-400">固定候选池回放实验</p></div>
          <div class="rounded-xl border border-white/70 bg-white/75 p-4 dark:border-gray-700 dark:bg-gray-900/60"><p class="text-2xl font-bold text-gray-950 dark:text-white">63.82% → 70.82–70.95%</p><p class="mt-1 text-xs text-gray-600 dark:text-gray-400">仅改变答案选择规则后的准确率</p></div>
        </div>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="https://arxiv.org/abs/2608.25937" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700">阅读论文 ↗</a>
          <span class="rounded-lg border border-indigo-200 bg-white/60 px-4 py-2.5 text-sm font-medium text-gray-700 dark:border-indigo-800 dark:bg-gray-900/50 dark:text-gray-200">arXiv:2608.25937 · cs.AI · cs.MA</span>
        </div>
      </article>

      <div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2">
        <article class="rounded-2xl border border-gray-200 bg-white/80 p-7 shadow-sm dark:border-gray-700 dark:bg-gray-800/70 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-emerald-600 dark:text-emerald-400">第一作者 · bioRxiv 2026</p>
          <h3 class="text-2xl font-bold text-gray-950 dark:text-white">
            <a href="https://www.biorxiv.org/content/10.64898/2026.05.27.727615v1" target="_blank" rel="noopener noreferrer" class="transition hover:text-indigo-600 dark:hover:text-indigo-400">SpatialDataAgent：十年尺度空间组学数据的自主整理</a>
          </h3>
          <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-300">建立具备证据追踪能力的智能体工作流，用于恢复和标准化分散的多模态空间组学记录；最终识别 769 组 H&amp;E–空间转录组配对数据，并构建包含 2,920 万个空间点或细胞的 HESRT 数据湖。</p>
          <a href="https://www.biorxiv.org/content/10.64898/2026.05.27.727615v1" target="_blank" rel="noopener noreferrer" class="mt-5 inline-flex text-sm font-semibold text-indigo-600 hover:text-indigo-800 dark:text-indigo-400">查看预印本 ↗</a>
        </article>

        <article class="rounded-2xl border border-gray-200 bg-white/80 p-7 shadow-sm dark:border-gray-700 dark:bg-gray-800/70 md:p-8">
          <p class="mb-3 text-xs font-bold uppercase tracking-[0.18em] text-amber-600 dark:text-amber-400">共同第一作者 · 手稿 2026</p>
          <h3 class="text-2xl font-bold leading-snug text-gray-950 dark:text-white">时空转录组揭示与阿尔茨海默病胆碱能易损性相关的反应性基底前脑小胶质细胞</h3>
          <p class="mt-4 leading-relaxed text-gray-600 dark:text-gray-300">整合空间转录组、单核测序与原位淀粉样病理，在 1,236 万个空间表达谱中解析疾病相关小胶质细胞状态及其与胆碱能神经元易损性的关系。</p>
        </article>
      </div>
    </section>

    <section id="about" class="mt-16 scroll-mt-24">
      <div class="mb-7 border-b border-gray-200 pb-4 dark:border-gray-700">
        <p class="mb-2 text-xs font-bold uppercase tracking-[0.2em] text-indigo-600 dark:text-indigo-400">About</p>
        <h2 class="text-3xl font-bold text-gray-950 dark:text-white">个人简介</h2>
      </div>

      <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
        <aside class="lg:col-span-4">
          <div class="rounded-2xl border border-gray-200 bg-white/80 p-6 shadow-sm dark:border-gray-700 dark:bg-gray-800/70">
            <img src="/avatar.jpg" alt="纪家灏的个人照片" class="mx-auto h-48 w-48 rounded-2xl object-cover shadow-sm ring-1 ring-gray-200 dark:ring-gray-700" />
            <div class="mt-5 text-center">
              <h3 class="text-xl font-bold text-gray-950 dark:text-white">纪家灏</h3>
              <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">Jia-Hao (Jay) Ji</p>
              <p class="mt-3 text-sm leading-relaxed text-gray-600 dark:text-gray-300">复旦大学上海医学院<br />八年制临床医学专业</p>
            </div>
            <div class="mt-6 grid grid-cols-1 gap-3">
              <a href="/Jia-Hao_Ji_CV_zh.pdf" target="_blank" rel="noopener noreferrer" class="rounded-lg bg-indigo-600 px-4 py-2.5 text-center text-sm font-semibold text-white transition hover:bg-indigo-700">中文一页简历</a>
              <a href="/Jia-Hao_Ji_CV.pdf" target="_blank" rel="noopener noreferrer" class="rounded-lg border border-gray-300 px-4 py-2.5 text-center text-sm font-semibold text-gray-700 transition hover:border-indigo-400 hover:text-indigo-600 dark:border-gray-700 dark:text-gray-200">English CV</a>
            </div>
          </div>
        </aside>

        <div class="space-y-6 lg:col-span-8">
          <div class="rounded-2xl border border-gray-200 bg-white/80 p-7 shadow-sm dark:border-gray-700 dark:bg-gray-800/70 md:p-9">
            <p class="text-base leading-8 text-gray-700 dark:text-gray-300 md:text-lg">
              我正在接受临床医学与计算科学的交叉训练，目标是成为能够连接医学问题、生物学机制与先进人工智能方法的医师科学家。当前工作重点不是泛化地“使用 AI”，而是构建可评价、可审计、能够真正扩展科研能力的智能系统。
            </p>
            <p class="mt-5 text-base leading-8 text-gray-700 dark:text-gray-300 md:text-lg">
              我的研究路径从分子生物学与单细胞分析起步，随后转向空间组学、多模态学习和自主科研智能体。目前，我尤其关注两个问题：如何让人工智能高效整合组织形态与分子状态，以及如何避免多智能体系统在已有正确候选的情况下仍然输出错误答案。
            </p>
          </div>

          <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
            <div class="rounded-2xl border border-indigo-100 bg-indigo-50/60 p-6 dark:border-indigo-800 dark:bg-indigo-900/20">
              <h3 class="font-bold text-gray-950 dark:text-white">当前研究平台</h3>
              <p class="mt-3 text-sm leading-7 text-gray-600 dark:text-gray-300">复旦大学数据驱动未来实验室与医学遗传研究所，在郁金泰教授和原致远教授指导下开展阿尔茨海默病空间组学与生物医学人工智能研究。</p>
            </div>
            <div class="rounded-2xl border border-cyan-100 bg-cyan-50/60 p-6 dark:border-cyan-800 dark:bg-cyan-900/20">
              <h3 class="font-bold text-gray-950 dark:text-white">联系与合作</h3>
              <p class="mt-3 text-sm leading-7 text-gray-600 dark:text-gray-300">欢迎围绕科学智能体、空间组学、多模态生物医学 AI 和可靠多智能体推理开展学术交流。</p>
              <a href="mailto:jhji19@fudan.edu.cn" class="mt-3 inline-flex text-sm font-semibold text-indigo-600 hover:underline dark:text-indigo-400">jhji19@fudan.edu.cn</a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>
