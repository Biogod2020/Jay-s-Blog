---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';
const posts = await getPosts();
---
<Layout title="Writing & Archive | Jia-Hao Ji" description="Essays, research notes and technical work on AI, medicine and society. Browse and search Jia-Hao Ji’s Chinese and English articles.">
  <header class="page-heading"><p class="eyebrow">Notes & essays / 文章</p><h1>Writing</h1><p>Research notes, practical experiments, and questions that stay with me.<br /><span lang="zh-CN">研究笔记、技术实践，以及医学与社会中的问题。</span></p></header>
  <div id="search" class="archive-tools" hidden>
    <div><label for="post-query">Search titles and summaries / 搜索标题与摘要</label><input id="post-query" type="search" placeholder="Agents, 医学, spatial omics…" autocomplete="off" aria-controls="post-results" /></div>
    <div><label for="post-language">Language / 语言</label><select id="post-language" aria-controls="post-results"><option value="all">All / 全部</option><option value="zh-CN">中文</option><option value="en">English</option></select></div>
  </div>
  <p class="result-count" id="result-count" role="status" aria-live="polite">{posts.length} articles · <a class="text-link" href="/subscribe/">Subscribe via RSS</a></p>
  <div id="post-results"><PostList posts={posts} searchable /></div>
  <p id="empty-results" class="empty-results" hidden>No matching articles. Try another phrase or language.<br /><span lang="zh-CN">没有匹配的文章，请更换关键词或语言。</span></p>
</Layout>
<script>
  const tools = document.getElementById('search');
  const input = document.getElementById('post-query') as HTMLInputElement;
  const language = document.getElementById('post-language') as HTMLSelectElement;
  const rows = [...document.querySelectorAll<HTMLElement>('[data-post-row]')];
  const count = document.getElementById('result-count');
  const empty = document.getElementById('empty-results');
  const url = new URL(location.href);
  input.value = url.searchParams.get('q') ?? '';
  const initial = url.searchParams.get('lang');
  if (initial === 'en' || initial === 'zh-CN') language.value = initial;
  function filter() {
    const terms = input.value.normalize('NFKC').toLowerCase().trim().split(/\s+/).filter(Boolean);
    let visible = 0;
    rows.forEach(row => {
      const matches = (language.value === 'all' || row.dataset.language === language.value) && terms.every(term => (row.dataset.search ?? '').includes(term));
      row.hidden = !matches;
      if (matches) visible++;
    });
    if (count) count.textContent = `${visible} / ${rows.length} articles`;
    if (empty) empty.hidden = visible > 0;
    const next = new URL(location.href);
    if (input.value.trim()) next.searchParams.set('q', input.value.trim()); else next.searchParams.delete('q');
    if (language.value !== 'all') next.searchParams.set('lang', language.value); else next.searchParams.delete('lang');
    history.replaceState(null, '', next);
  }
  if (tools) tools.hidden = false;
  input.addEventListener('input', filter);
  language.addEventListener('change', filter);
  filter();
</script>
