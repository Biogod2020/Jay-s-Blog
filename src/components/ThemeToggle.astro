---
const { lang = 'en' } = Astro.props;
const label = lang === 'zh-CN' ? '切换深色模式' : 'Toggle dark mode';
---
<button id="theme-toggle" class="theme-toggle" type="button" aria-label={label} title={label} aria-pressed="false">
  <svg class="theme-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M20.8 13.3A9 9 0 0 1 10.7 3.2a9 9 0 1 0 10.1 10.1Z" /></svg>
  <svg class="theme-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button>
<script>
  const button = document.getElementById('theme-toggle');
  const sync = () => button?.setAttribute('aria-pressed', String(document.documentElement.classList.contains('dark')));
  sync();
  button?.addEventListener('click', () => {
    const dark = document.documentElement.classList.toggle('dark');
    try { localStorage.setItem('color-theme', dark ? 'dark' : 'light'); } catch {}
    sync();
  });
</script>
