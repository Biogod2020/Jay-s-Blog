<button id="theme-toggle" type="button" aria-label="Switch colour theme / 切换深浅主题" aria-pressed="false" class="rounded-lg p-2 text-gray-500 hover:bg-gray-100 focus-visible:ring-2 focus-visible:ring-indigo-500 dark:text-gray-400 dark:hover:bg-gray-700">
  <svg class="h-5 w-5 dark:hidden" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M21 12.8A9 9 0 0111.2 3 9 9 0 1021 12.8Z" /></svg>
  <svg class="hidden h-5 w-5 dark:block" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5"/></svg>
</button>
<script>
  const button=document.getElementById('theme-toggle');
  const update=()=>button?.setAttribute('aria-pressed',String(document.documentElement.classList.contains('dark')));
  update();
  button?.addEventListener('click',()=>{
    const dark=document.documentElement.classList.toggle('dark');
    try{localStorage.setItem('color-theme',dark?'dark':'light');}catch{}
    update();
  });
</script>
