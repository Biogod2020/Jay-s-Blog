---
import type { MarkdownHeading } from 'astro';
interface Props { headings: MarkdownHeading[]; lang?: string; }
const { headings, lang = 'en' } = Astro.props;
const toc = headings.filter(heading => heading.depth === 2 || heading.depth === 3);
const title = lang.startsWith('zh') ? '本文目录' : 'On this page';
---
<aside class="toc" data-toc-container hidden={toc.length === 0}>
  <nav aria-label={title}><p class="toc-title">{title}</p><ul class="toc-list" data-toc-list>{toc.map(h => <li class:list={{'toc-sub':h.depth === 3}}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
</aside>
<details class="toc-mobile" data-toc-container hidden={toc.length === 0}><summary>{title}</summary><nav aria-label={title}><ul class="toc-list" data-toc-list>{toc.map(h => <li class:list={{'toc-sub':h.depth === 3}}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav></details>
<script>
  // Raw-HTML legacy posts may have no Markdown headings. Keep a safe, small fallback.
  const lists = document.querySelectorAll<HTMLElement>('[data-toc-list]');
  if (lists.length && !lists[0].children.length) {
    const headings = [...document.querySelectorAll<HTMLElement>('.article-body h2, .article-body h3')];
    headings.forEach((heading, index) => {
      if (!heading.id) {
        let id = `article-section-${index + 1}`;
        while (document.getElementById(id)) id += '-';
        heading.id = id;
      }
      lists.forEach(list => {
        const li = document.createElement('li');
        if (heading.tagName === 'H3') li.className = 'toc-sub';
        const link = document.createElement('a');
        link.setAttribute('href', `#${heading.id}`); link.textContent = heading.textContent;
        li.append(link); list.append(li);
      });
    });
    if (headings.length) document.querySelectorAll<HTMLElement>('[data-toc-container]').forEach(el => { el.hidden = false; });
  }
</script>
