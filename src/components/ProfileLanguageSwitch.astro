---
interface Props {
  current: "en" | "zh";
}

const { current } = Astro.props;
const options = [
  { key: "en", label: "English", href: "/about" },
  { key: "zh", label: "中文", href: "/about/zh/" },
] as const;
---

<nav
  aria-label={current === "zh" ? "个人详情页面语言" : "Profile page language"}
  class="inline-flex rounded-full border border-gray-200 bg-white/80 p-1 shadow-sm backdrop-blur dark:border-gray-700 dark:bg-gray-800/80"
>
  {
    options.map((option) => {
      const active = option.key === current;
      return (
        <a
          href={option.href}
          aria-current={active ? "page" : undefined}
          class:list={[
            "rounded-full px-3.5 py-1.5 text-sm font-semibold transition",
            active
              ? "bg-indigo-600 text-white shadow-sm"
              : "text-gray-500 hover:bg-indigo-50 hover:text-indigo-600 dark:text-gray-300 dark:hover:bg-indigo-950/50 dark:hover:text-indigo-300",
          ]}
        >
          {option.label}
        </a>
      );
    })
  }
</nav>
