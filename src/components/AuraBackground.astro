<div class="fixed inset-0 -z-20 pointer-events-none overflow-hidden bg-slate-50 dark:bg-gray-950 transition-colors duration-500">
  <!-- Top Right Glow -->
  <div class="absolute -top-40 -right-40 w-96 h-96 rounded-full bg-indigo-300 dark:bg-indigo-900 mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-50 dark:opacity-30 animate-blob"></div>
  
  <!-- Bottom Left Glow -->
  <div class="absolute -bottom-40 -left-40 w-96 h-96 rounded-full bg-purple-300 dark:bg-purple-900 mix-blend-multiply dark:mix-blend-lighten filter blur-[100px] opacity-50 dark:opacity-30 animate-blob animation-delay-2000"></div>
  
  <!-- Center Accent Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-blue-200 dark:bg-blue-900/50 mix-blend-multiply dark:mix-blend-lighten filter blur-[120px] opacity-30 dark:opacity-20 animate-blob animation-delay-4000"></div>
  
  <!-- SVG Grid Overlay (Inline to avoid missing file issues) -->
  <div class="absolute inset-0 opacity-[0.03] dark:opacity-[0.02]" style="background-image: url('data:image/svg+xml,%3Csvg width=\'60\' height=\'60\' viewBox=\'0 0 60 60\' xmlns=\'http://www.w3.org/2000/svg\'%3E%3Cpath d=\'M54.627 0l.83.83v58.34h-58.34l-.83-.83V0h58.34zM53.8 1.66H1.66v53.8h52.14V1.66z\' fill=\'%23000000\' fill-opacity=\'1\' fill-rule=\'evenodd\'/%3E%3C/svg%3E'); mask-image: linear-gradient(to bottom, black 40%, transparent 100%); -webkit-mask-image: linear-gradient(to bottom, black 40%, transparent 100%);"></div>
</div>

<style>
  @keyframes blob {
    0% {
      transform: translate(0px, 0px) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
    100% {
      transform: translate(0px, 0px) scale(1);
    }
  }
  
  .animate-blob {
    animation: blob 15s infinite alternate;
  }
  
  .animation-delay-2000 {
    animation-delay: 2s;
  }
  
  .animation-delay-4000 {
    animation-delay: 4s;
  }
</style>